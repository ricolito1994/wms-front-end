{
  "compilerOptions": {
    "target": "ESNext",                         // Vite targets modern browsers
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",                         // ✅ fine if you prefer this
    "paths": {
      "@/*": ["*"]                              // ✅ if using @ as alias
    },
    "types": ["vite/client"]                    // ✅ needed for `import.meta.env`
  },
  "include": ["src"]
}
